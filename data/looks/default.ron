// The look of a room without its own `look.ron` (docs/REMAKE.md §3).
// Our own neutral placeholder, not measured from the original: cool
// moonlight and a soft ambient term until a room has its own look and baked
// lighting. Units: exposure in EV100 (9.15 with BlenderFilmic matches
// Blender's Filmic view at exposure 0, given its exporter's 683 lm/W; see
// docs/REMAKE.md §3), moonlight in lux, ambient in cd/m², fog visibility in
// metres.
(
    schema: 1,
    exposure_ev100: 9.15,
    tonemapping: BlenderFilmic,
    bloom: 0.08,
    ambient: (colour: (0.72, 0.76, 0.92), brightness: 450.0),
    moon: (
        colour: (0.70, 0.78, 1.0),
        illuminance: 3000.0,
        direction: (0.35, -1.0, -0.45),
        shafts: true,
    ),
    fog: (colour: (0.04, 0.04, 0.07), visibility: 260.0),
    haze: Some((colour: (0.75, 0.80, 1.0), density: 0.006, scattering_asymmetry: 0.6)),
    grading: (
        temperature: -0.03,
        tint: 0.02,
        hue: 0.0,
        post_saturation: 1.1,
        shadows: (saturation: 1.15, contrast: 1.05, gamma: 1.0, gain: 1.0, lift: 0.0),
        midtones: (saturation: 1.05, contrast: 1.0, gamma: 1.0, gain: 1.0, lift: 0.0),
        highlights: (saturation: 0.95, contrast: 1.0, gamma: 1.0, gain: 1.0, lift: 0.0),
    ),
)
